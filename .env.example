# Required
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Allowlisted text channels and/or categories (at least one of the two).
# Every text channel in a listed category, and threads under it, is allowed.
DISCORD_CHANNEL_IDS=
DISCORD_CATEGORY_IDS=
# Comma-separated Discord user IDs whose messages are forwarded. Required in intake mode.
DISCORD_ALLOWED_USER_IDS=

# Optional
# Default true: every allowed user's message in an allowlisted channel/category is forwarded (no @mention needed).
DISCORD_INTAKE_MODE=
# Extra role check on top of DISCORD_ALLOWED_USER_IDS.
DISCORD_ALLOWED_ROLE_IDS=
BOT_NAME_PREFIX=

# Webhook (URL and secret are required together).
# Copy both from the Grok Bot webhook routine panel. Public HTTPS only; http://127.0.0.1 is allowed for local tests.
GROK_WEBHOOK_URL=
GROK_WEBHOOK_SECRET=
