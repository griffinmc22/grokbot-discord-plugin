# Required
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Allowlisted text channels and/or categories (at least one of the two).
# Every text channel in a listed category, and threads under it, is allowed.
DISCORD_CHANNEL_IDS=
DISCORD_CATEGORY_IDS=
# Comma-separated Discord user IDs whose messages are handled (channels and DMs). Required in intake mode.
DISCORD_ALLOWED_USER_IDS=

# Optional
# Default true: allowed users only; in guild channels the bot must be @mentioned or replied to.
# false = legacy chat mode (mention, reply, bot name, or follow-up window).
DISCORD_INTAKE_MODE=
# Default true: every DM to the bot from an allowed user is forwarded (no mention). false = ignore DMs.
DISCORD_DM_INTAKE=
# Reactions (commented out on purpose: unset = default, but an explicitly empty value disables).
# Ack the moment a message is accepted (default 👀) and mark failed forwards (default ⚠️).
# Unicode, name:id, or <:name:id>. Use none/off (or an empty value) to disable.
# DISCORD_ACK_EMOJI=👀
# DISCORD_ERROR_EMOJI=⚠️
# Extra role check in guild channels, on top of DISCORD_ALLOWED_USER_IDS.
DISCORD_ALLOWED_ROLE_IDS=
BOT_NAME_PREFIX=

# Webhook (URL and secret are required together).
# Copy both from the Grok Bot webhook routine panel. Public HTTPS only; http://127.0.0.1 is allowed for local tests.
GROK_WEBHOOK_URL=
GROK_WEBHOOK_SECRET=
